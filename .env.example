# DeepSeek API Key（主对话、grader、联网搜索共用）
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
MONGODB_URI= #这里我使用的本地的mongdb，当然可以使用docker
ERP_BASE_URL=http://localhost:8081
# MCP 工具默认内嵌到后端进程直接加载；设 false 则改用独立 MCP Server
MCP_USE_EMBEDDED=true
# 独立 MCP Server 的传输方式：streamable-http（默认，端点 /mcp）或 sse（旧版，端点 /sse）
MCP_TRANSPORT=streamable-http
MCP_SERVER_URL=http://localhost:9000
SANDBOX_IMAGE=erp-agent-sandbox:latest         
# 本地 Mock ERP 的 PostgreSQL 连接（docker compose 默认值）
ERP_DB_URL=postgresql+psycopg2://postgres:postgres123@localhost:5432/erp_agent

# ===== 三层记忆（HOT / WARM / COLD，均可不配，走默认值）=====
# 情节记忆在 WARM 层停留天数，超过后只在 COLD 按需检索
MEMORY_WARM_EPISODE_DAYS=7
# 情节记忆保留天数，过期后被遗忘（硬删除）
MEMORY_EPISODE_TTL_DAYS=90
# COLD 层单次检索返回条数
MEMORY_RETRIEVAL_K=5
# 每位用户最多保留的情节条数
MEMORY_MAX_EPISODES=200
# 是否向 Agent 暴露 read_memory / remember 工具
MEMORY_TOOLS_ENABLED=true
# 是否启用 LLM 抽取偏好（默认关闭，走零成本确定性规则）
MEMORY_LLM_EXTRACTION=false
# 可选：禁用不需要的外部 MCP（对应 config/mcp.json 里的 server 名，逗号分隔）
# 冷启动时每个外部 server 都要建连，禁掉可省数秒；内置 ERP 工具不受影响
# MCP_DISABLED_SERVERS=bing-search,amap-maps,12306
# 审查路由：默认保留 DeepSeek；可选 jev（独立于主 Agent / Grader）
REVIEW_ROUTER_PROVIDER=deepseek
# jev 决策模型的端点（默认官方 systemone，走代理/自建网关时改成对应地址）
TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# ===== 网关进程参数（不填走默认值）=====
# GATEWAY_HOST=0.0.0.0
# GATEWAY_PORT=8000
# 逗号分隔；默认只允许本地前端
# CORS_ORIGINS=http://localhost:3000

# ===== LangSmith 追踪（默认关闭；本地/CI 不要打开）=====
LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=erp-agent
